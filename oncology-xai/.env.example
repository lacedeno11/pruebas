# DERCAS-ONCO-XAI V1 - Environment Configuration Template
# Copy this file to .env and customize the values for your environment

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Application settings
APP_NAME=DERCAS-ONCO-XAI
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oncology_xai
POSTGRES_USER=oncology_user
POSTGRES_PASSWORD=oncology_password
POSTGRES_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# MESSAGE BROKER & QUEUE CONFIGURATION
# =============================================================================

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}${RABBITMQ_VHOST}

# RabbitMQ Management
RABBITMQ_MANAGEMENT_PORT=15672

# Redis (Celery Backend)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Celery Configuration
CELERY_BROKER_URL=${RABBITMQ_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# =============================================================================
# OBJECT STORAGE CONFIGURATION (MinIO/S3)
# =============================================================================

# MinIO Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=oncology-xai
S3_SECURE=false

# MinIO Console
MINIO_CONSOLE_PORT=9001

# Bucket Configuration
S3_BUCKET_IMAGES=oncology-xai-images
S3_BUCKET_OVERLAYS=oncology-xai-overlays
S3_BUCKET_XAI=oncology-xai-xai
S3_BUCKET_EHR=oncology-xai-ehr
S3_BUCKET_REPORTS=oncology-xai-reports
S3_BUCKET_ONTOLOGY=oncology-xai-ontology

# =============================================================================
# AUTHENTICATION & AUTHORIZATION (Keycloak)
# =============================================================================

# Keycloak Configuration
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=oncology-xai
KEYCLOAK_CLIENT_ID=oncology-xai-client
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
KEYCLOAK_URL=http://${KEYCLOAK_HOST}:${KEYCLOAK_PORT}
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# JWT Configuration
JWKS_URL=${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/certs
JWT_ALGORITHM=RS256
JWT_AUDIENCE=${KEYCLOAK_CLIENT_ID}
JWT_ISSUER=${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}

# Token settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# TRIPLE STORE CONFIGURATION (Apache Jena Fuseki)
# =============================================================================

# Fuseki Configuration
FUSEKI_HOST=localhost
FUSEKI_PORT=3030
FUSEKI_URL=http://${FUSEKI_HOST}:${FUSEKI_PORT}
FUSEKI_DATASET=oncology-xai
FUSEKI_ADMIN_USER=admin
FUSEKI_ADMIN_PASSWORD=admin

# Named Graphs
FUSEKI_GRAPH_NCIT=http://purl.obolibrary.org/obo/ncit
FUSEKI_GRAPH_MONDO=http://purl.obolibrary.org/obo/mondo
FUSEKI_GRAPH_SO=http://purl.obolibrary.org/obo/so
FUSEKI_GRAPH_CASES=http://oncology-xai.org/cases

# =============================================================================
# AI/ML CONFIGURATION
# =============================================================================

# LLM Provider Configuration
LLM_PROVIDER=mock  # Options: mock, openai, anthropic
LLM_MODEL=gpt-4  # Model to use when provider is not mock
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORG_ID=your-openai-org-id-here

# Anthropic Configuration (if using Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ML Model Backend
MODEL_BACKEND=mock  # Options: mock, triton
TRITON_URL=http://localhost:8000  # Triton Inference Server URL

# Model Configuration
PATTERN_MODEL_VERSION=lung_patterns_v3
MUTATION_MODEL_VERSION=lung_mutations_v2
XAI_MODEL_VERSION=xai_v1

# Inference Thresholds
PATTERN_THRESHOLD_LEPIDIC=0.55
PATTERN_THRESHOLD_ACINAR=0.55
PATTERN_THRESHOLD_PAPILLARY=0.55
PATTERN_THRESHOLD_MICROPAPILLARY=0.55
PATTERN_THRESHOLD_SOLID=0.55
MUTATION_THRESHOLD_EGFR=0.6
MUTATION_THRESHOLD_KRAS=0.6
MUTATION_THRESHOLD_TP53=0.6

# =============================================================================
# OBSERVABILITY & MONITORING
# =============================================================================

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=oncology-xai
OTEL_RESOURCE_ATTRIBUTES=service.name=oncology-xai,service.version=1.0.0

# Jaeger Tracing
JAEGER_HOST=localhost
JAEGER_PORT=14268
JAEGER_UI_PORT=16686
JAEGER_AGENT_PORT=6831

# Prometheus Metrics
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090
PROMETHEUS_PUSHGATEWAY_PORT=9091

# Grafana (Optional)
GRAFANA_HOST=localhost
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# API Gateway
API_GATEWAY_HOST=localhost
API_GATEWAY_PORT=8080
API_GATEWAY_WORKERS=4

# Case Service
CASE_SERVICE_HOST=localhost
CASE_SERVICE_PORT=8001
CASE_SERVICE_WORKERS=2

# Image Service
IMAGE_SERVICE_HOST=localhost
IMAGE_SERVICE_PORT=8002
IMAGE_SERVICE_WORKERS=2
IMAGE_MAX_SIZE_MB=100
IMAGE_ALLOWED_FORMATS=png,biff

# Inference Service
INFERENCE_SERVICE_HOST=localhost
INFERENCE_SERVICE_PORT=8003
INFERENCE_SERVICE_WORKERS=2
INFERENCE_TIMEOUT_SECONDS=300

# EHR Service
EHR_SERVICE_HOST=localhost
EHR_SERVICE_PORT=8004
EHR_SERVICE_WORKERS=2

# Graph Service
GRAPH_SERVICE_HOST=localhost
GRAPH_SERVICE_PORT=8005
GRAPH_SERVICE_WORKERS=2

# Ontology Admin Service
ONTOLOGY_ADMIN_SERVICE_HOST=localhost
ONTOLOGY_ADMIN_SERVICE_PORT=8006
ONTOLOGY_ADMIN_SERVICE_WORKERS=1

# Audit Service
AUDIT_SERVICE_HOST=localhost
AUDIT_SERVICE_PORT=8007
AUDIT_SERVICE_WORKERS=2

# Frontend Web App
WEBAPP_HOST=localhost
WEBAPP_PORT=3000

# =============================================================================
# CLINICAL CONFIGURATION
# =============================================================================

# Clinical Guardrails
ENABLE_CLINICAL_GUARDRAILS=true
REQUIRE_DISCLAIMERS=true
PREVENT_DEFINITIVE_DIAGNOSIS=true
ENABLE_CONFLICT_DETECTION=true

# Supported Patterns
SUPPORTED_PATTERNS=lepidic,acinar,papillary,micropapillary,solid

# Supported Mutations
SUPPORTED_MUTATIONS=EGFR,KRAS,TP53

# Supported Ontologies
SUPPORTED_ONTOLOGIES=NCIt,MONDO,SO

# =============================================================================
# ONTOLOGY MANAGEMENT
# =============================================================================

# Ontology Sources (Whitelisted)
ONTOLOGY_SOURCES_WHITELIST=https://purl.obolibrary.org/obo/ncit.owl,https://purl.obolibrary.org/obo/mondo.owl,https://purl.obolibrary.org/obo/so.owl

# Ontology Update Configuration
ONTOLOGY_UPDATE_MODE=offline  # Options: offline, online
ONTOLOGY_AUTO_UPDATE=false
ONTOLOGY_BACKUP_RETENTION_DAYS=30

# Reasoner Configuration
REASONER_BACKEND=owlrl  # Options: owlrl, hermit, pellet
REASONER_TIMEOUT_SECONDS=60

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# File Upload Security
ENABLE_VIRUS_SCANNING=false
MAX_UPLOAD_SIZE_MB=100
ALLOWED_MIME_TYPES=image/png,application/octet-stream

# Audit Configuration
AUDIT_RETENTION_DAYS=365
AUDIT_LOG_LEVEL=INFO
ENABLE_PHI_REDACTION=true

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================

# Development Settings
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILING=false
MOCK_EXTERNAL_SERVICES=true

# Testing Configuration
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/test_oncology_xai
TEST_REDIS_URL=redis://localhost:6379/1
TEST_S3_BUCKET=test-oncology-xai

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Connection Timeouts
HTTP_TIMEOUT_SECONDS=30
DATABASE_TIMEOUT_SECONDS=30
REDIS_TIMEOUT_SECONDS=5

# Worker Configuration
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# Cache Configuration
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=oncology-xai-backups

# =============================================================================
# COMPLIANCE & PRIVACY
# =============================================================================

# Privacy Settings
ENABLE_DATA_ENCRYPTION=true
ENABLE_AUDIT_LOGGING=true
DATA_RETENTION_DAYS=2555  # 7 years
ENABLE_RIGHT_TO_ERASURE=true

# Compliance
HIPAA_COMPLIANCE_MODE=true
GDPR_COMPLIANCE_MODE=true
ENABLE_CONSENT_MANAGEMENT=true
