# Ontology Admin Service Configuration

# Service
SERVICE_NAME=ontology-admin-service
VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Database
POSTGRES_DSN=postgresql+asyncpg://oncology:oncology_secret@postgres:5432/oncology_xai

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Redis (Celery)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Reasoner
REASONER_BACKEND=mock  # Options: mock, owlrl

# Allowed ontology sources (comma-separated)
ALLOWED_ONTOLOGY_SOURCES=NCIt,MONDO,SO

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
