# Application Settings
APP_NAME=Audit Service
APP_VERSION=1.0.0
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8007

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/audit_db
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# RabbitMQ Settings
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=oncology.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_QUEUE=audit.events
RABBITMQ_ROUTING_KEY=#
RABBITMQ_PREFETCH_COUNT=10

# API Settings
API_V1_PREFIX=/api/v1

# Pagination Settings
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=1000

# Logging Settings
LOG_LEVEL=INFO
