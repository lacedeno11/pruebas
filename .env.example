# DERCAS 01 Policy Validation Copilot - Environment Configuration Template
# Copy this file to .env and update the values for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="DERCAS 01 Policy Validation Copilot"
APP_VERSION="0.1.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=true
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST="0.0.0.0"
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# Security
SECRET_KEY="your-secret-key-here-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM="HS256"

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database
DATABASE_URL="postgresql://dercas01:password@localhost:5432/dercas01_db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis for caching and task queue
REDIS_URL="redis://localhost:6379/0"
REDIS_PASSWORD=""

# =============================================================================
# VECTOR DATABASE (ChromaDB)
# =============================================================================
CHROMADB_HOST="localhost"
CHROMADB_PORT=8001
CHROMADB_COLLECTION_NAME="policy_documents"
CHROMADB_PERSIST_DIRECTORY="./data/chromadb"

# Embedding model configuration
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DEVICE="cpu"  # cpu, cuda, mps

# =============================================================================
# OBJECT STORAGE
# =============================================================================
# File storage for PDF/Excel documents
OBJECT_STORAGE_TYPE="local"  # local, s3, azure, gcp
OBJECT_STORAGE_PATH="./data/documents"

# S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME="dercas01-documents"

# =============================================================================
# ML SERVICES CONFIGURATION
# =============================================================================
# ML Model Registry
MODEL_REGISTRY_URL="http://localhost:5000"
MODEL_REGISTRY_USERNAME=""
MODEL_REGISTRY_PASSWORD=""

# Feature Store
FEATURE_STORE_URL="http://localhost:6000"
FEATURE_STORE_API_KEY=""

# ML Service Endpoints
ML_CLASSIFY_URL="http://localhost:8001/classify"
ML_ANOMALY_URL="http://localhost:8002/anomaly"
ML_ETA_URL="http://localhost:8003/eta"

# Model versions (can be overridden per request)
DEFAULT_CLASSIFY_MODEL_VERSION="v1.0.0"
DEFAULT_ANOMALY_MODEL_VERSION="v1.0.0"
DEFAULT_ETA_MODEL_VERSION="v1.0.0"

# =============================================================================
# LANGGRAPH CONFIGURATION
# =============================================================================
# LangGraph execution settings
LANGGRAPH_MAX_ITERATIONS=50
LANGGRAPH_TIMEOUT_SECONDS=300
LANGGRAPH_CHECKPOINT_ENABLED=true

# LangChain/LLM Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="dercas01-policy-validation"

# OpenAI (if using OpenAI models)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4"

# =============================================================================
# GUARDRAILS CONFIGURATION
# =============================================================================
# Security settings
ENABLE_RBAC=true
ENABLE_PII_MASKING=true
ENABLE_SOURCE_VALIDATION=true
ENABLE_ANTI_HALLUCINATION=true

# PII Detection
PII_DETECTION_THRESHOLD=0.8
PII_MASKING_CHAR="*"

# Source allowlist
ALLOWED_DOCUMENT_SOURCES="internal,approved_external"
DOCUMENT_VERIFICATION_REQUIRED=true

# =============================================================================
# DECISION THRESHOLDS
# =============================================================================
# Auto-close thresholds (configurable per business rules)
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MEDIUM_THRESHOLD=0.65
RISK_LOW_THRESHOLD=0.3
RISK_HIGH_THRESHOLD=0.7
COVERAGE_OK_THRESHOLD=0.8
ANOMALY_HIGH_THRESHOLD=0.8

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================
# CRM/Ticketing System
CRM_API_URL="https://api.crm-system.com"
CRM_API_KEY=""
CRM_WEBHOOK_SECRET=""

# Insurance Company APIs
INSURER_API_TIMEOUT=30
INSURER_API_RETRIES=3

# Notification Services
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=""
EMAIL_PASSWORD=""
EMAIL_FROM_ADDRESS="noreply@dercas01.com"

# Slack notifications (optional)
SLACK_WEBHOOK_URL=""
SLACK_CHANNEL="#dercas01-alerts"

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================
# Metrics and monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Logging
LOG_FORMAT="json"  # json, text
LOG_FILE_PATH="./logs/dercas01.log"
LOG_ROTATION_SIZE="100MB"
LOG_RETENTION_DAYS=30

# Health checks
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# =============================================================================
# CELERY TASK QUEUE
# =============================================================================
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
CELERY_TASK_SERIALIZER="json"
CELERY_RESULT_SERIALIZER="json"
CELERY_TIMEZONE="UTC"

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development tools
ENABLE_SWAGGER_UI=true
ENABLE_REDOC=true
ENABLE_DEBUG_TOOLBAR=false

# Testing
TEST_DATABASE_URL="postgresql://dercas01:password@localhost:5432/dercas01_test_db"
TEST_REDIS_URL="redis://localhost:6379/15"

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Production-specific settings (override in production)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE=0.1

# SSL/TLS
SSL_CERT_PATH=""
SSL_KEY_PATH=""
SSL_CA_CERTS=""
