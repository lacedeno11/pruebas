# =============================================================================
# Policy Validation Copilot - Environment Configuration
# =============================================================================

# Application Settings
APP_NAME=Policy Validation Copilot
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# Security Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database Configuration
DATABASE_URL=postgresql+asyncpg://policy_user:policy_pass@localhost:5432/policy_copilot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis Configuration (for caching and queues)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# Vector Database Configuration (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=policy_documents
CHROMA_PERSIST_DIRECTORY=./data/chroma

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.1

# LangGraph Configuration
LANGGRAPH_CHECKPOINT_STORE=memory
LANGGRAPH_MAX_ITERATIONS=50
LANGGRAPH_TIMEOUT_SECONDS=300

# Object Storage Configuration (MinIO/S3)
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=policy-documents
OBJECT_STORAGE_SECURE=false

# ML Services Configuration
ML_MODEL_REGISTRY_URL=http://localhost:5000
ML_FEATURE_STORE_URL=http://localhost:8080
ML_CLASSIFICATION_MODEL_VERSION=v1.0.0
ML_ANOMALY_MODEL_VERSION=v1.0.0
ML_ETA_MODEL_VERSION=v1.0.0

# Guardrails Configuration
GUARDRAILS_ENABLED=true
RBAC_ENABLED=true
PII_MASKING_ENABLED=true
ALLOWLIST_SOURCES_ONLY=true
ANTI_HALLUCINATION_ENABLED=true

# HITL Configuration
HITL_QUEUE_URL=http://localhost:15672
HITL_NOTIFICATION_EMAIL_ENABLED=false
HITL_NOTIFICATION_SLACK_ENABLED=false
HITL_AUTO_ASSIGNMENT_ENABLED=true

# Monitoring and Observability
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
JAEGER_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces
STRUCTLOG_ENABLED=true

# External Integrations
CRM_WEBHOOK_URL=http://localhost:8080/webhooks/crm
CRM_API_KEY=your-crm-api-key
INSURER_API_TIMEOUT=30
INSURER_API_RETRIES=3

# Audit and Compliance
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=2555  # 7 years
EVIDENCE_HASH_ALGORITHM=sha256
EXPORT_ENCRYPTION_ENABLED=true

# Development Settings
RELOAD=true
WORKERS=1
TESTING=false
MOCK_EXTERNAL_SERVICES=true
