# Policy Validation Copilot Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="Policy Validation Copilot"
APP_VERSION="0.1.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=true
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST="0.0.0.0"
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# Security
SECRET_KEY="your-super-secret-key-change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM="HS256"

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Primary Database
DATABASE_URL="postgresql+asyncpg://policy_user:policy_pass@localhost:5432/policy_validation"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Database Migration
ALEMBIC_CONFIG="alembic.ini"

# =============================================================================
# VECTOR DATABASE & KNOWLEDGE BASE
# =============================================================================
# ChromaDB for vector storage
CHROMA_HOST="localhost"
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME="policy_documents"

# Alternative: Faiss for local vector storage
FAISS_INDEX_PATH="./data/faiss_index"

# =============================================================================
# OBJECT STORAGE
# =============================================================================
# S3-compatible storage for documents and attachments
STORAGE_TYPE="s3"  # s3, local, azure, gcs
S3_BUCKET_NAME="policy-validation-documents"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_ENDPOINT_URL=""  # For MinIO or other S3-compatible services

# Local storage fallback
LOCAL_STORAGE_PATH="./data/storage"

# =============================================================================
# ML SERVICES CONFIGURATION
# =============================================================================
# ML Classification Service
ML_CLASSIFY_URL="http://localhost:8002"
ML_CLASSIFY_API_KEY="your-ml-classify-api-key"
ML_CLASSIFY_TIMEOUT=30
ML_CLASSIFY_RETRIES=3

# ML Anomaly Detection Service
ML_ANOMALY_URL="http://localhost:8003"
ML_ANOMALY_API_KEY="your-ml-anomaly-api-key"
ML_ANOMALY_TIMEOUT=30
ML_ANOMALY_RETRIES=3

# ML ETA Prediction Service
ML_ETA_URL="http://localhost:8004"
ML_ETA_API_KEY="your-ml-eta-api-key"
ML_ETA_TIMEOUT=30
ML_ETA_RETRIES=3

# Feature Store
FEATURE_STORE_URL="http://localhost:8005"
FEATURE_STORE_API_KEY="your-feature-store-api-key"

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# OpenAI Configuration
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4"
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2000

# Alternative LLM providers
ANTHROPIC_API_KEY="your-anthropic-api-key"
AZURE_OPENAI_ENDPOINT="your-azure-endpoint"
AZURE_OPENAI_API_KEY="your-azure-api-key"

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================
# CRM/Ticketing System
CRM_BASE_URL="https://your-crm-system.com/api"
CRM_API_KEY="your-crm-api-key"
CRM_WEBHOOK_SECRET="your-webhook-secret"

# Insurance Company APIs
INSURER_API_TIMEOUT=60
INSURER_API_RETRIES=3

# Notification Services
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@company.com"
SMTP_PASSWORD="your-email-password"
SMTP_USE_TLS=true

# Slack Integration
SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"
SLACK_CHANNEL_ALERTS="#policy-alerts"
SLACK_CHANNEL_HITL="#policy-hitl"

# =============================================================================
# GUARDRAILS & SECURITY
# =============================================================================
# RBAC/ABAC Configuration
RBAC_ENABLED=true
RBAC_PROVIDER="internal"  # internal, oauth2, ldap

# PII Masking
PII_MASKING_ENABLED=true
PII_MASKING_LEVEL="partial"  # none, partial, full

# Source Allowlist
SOURCE_ALLOWLIST_ENABLED=true
SOURCE_ALLOWLIST_STRICT=true

# Anti-hallucination
ANTI_HALLUCINATION_ENABLED=true
ANTI_HALLUCINATION_THRESHOLD=0.8

# Security Monitoring
SECURITY_MONITORING_ENABLED=true
SECURITY_LOG_LEVEL="WARNING"

# =============================================================================
# HITL (HUMAN-IN-THE-LOOP) CONFIGURATION
# =============================================================================
# Queue Management
HITL_QUEUE_ENABLED=true
HITL_QUEUE_PRIORITY_LEVELS=5
HITL_QUEUE_SLA_HOURS=24

# Approval Workflow
HITL_APPROVAL_TIMEOUT_HOURS=48
HITL_ESCALATION_ENABLED=true
HITL_ESCALATION_TIMEOUT_HOURS=72

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Structured Logging
LOG_FORMAT="json"  # json, text
LOG_FILE_PATH="./logs/app.log"
LOG_ROTATION_SIZE="100MB"
LOG_RETENTION_DAYS=30

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# =============================================================================
# PERFORMANCE & SCALING
# =============================================================================
# Caching
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Background Tasks
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
CELERY_WORKERS=4

# =============================================================================
# BUSINESS RULES & THRESHOLDS
# =============================================================================
# Decision Thresholds
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MEDIUM_THRESHOLD=0.65
RISK_HIGH_THRESHOLD=0.75
RISK_MEDIUM_THRESHOLD=0.45
COVERAGE_OK_THRESHOLD=0.80
ANOMALY_HIGH_THRESHOLD=0.70

# SLA Configuration
DEFAULT_SLA_HOURS=48
PRIORITY_HIGH_SLA_HOURS=24
PRIORITY_CRITICAL_SLA_HOURS=12

# Auto-close Rules
AUTO_CLOSE_ENABLED=true
AUTO_CLOSE_CONFIDENCE_MIN=0.90
AUTO_CLOSE_RISK_MAX=0.30
AUTO_CLOSE_COVERAGE_MIN=0.85

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
# Testing Configuration
TEST_DATABASE_URL="postgresql+asyncpg://test_user:test_pass@localhost:5433/test_policy_validation"
TEST_STORAGE_PATH="./test_data/storage"
TEST_ML_MOCK_ENABLED=true

# Development Tools
DEV_RELOAD_ENABLED=true
DEV_DEBUG_TOOLBAR=true
DEV_PROFILING_ENABLED=false
