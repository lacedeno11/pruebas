# DERCAS-ONCO-XAI V1 - Environment Variables Template
# Copy this file to .env and update with your actual values

# Database Configuration
POSTGRES_DSN=postgresql://oncology_user:oncology_pass@localhost:5432/oncology_db
POSTGRES_USER=oncology_user
POSTGRES_PASSWORD=oncology_pass
POSTGRES_DB=oncology_db

# Message Broker Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
REDIS_URL=redis://localhost:6379/0

# Object Storage Configuration (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=oncology-xai
S3_REGION=us-east-1

# Authentication Configuration (Keycloak)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=oncology-xai
KEYCLOAK_CLIENT_ID=oncology-client
KEYCLOAK_CLIENT_SECRET=your-client-secret
JWKS_URL=http://localhost:8080/realms/oncology-xai/protocol/openid-connect/certs

# Triple Store Configuration (Fuseki)
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET=oncology

# LLM Configuration
LLM_PROVIDER=mock  # mock|openai|anthropic
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ML Model Configuration
MODEL_BACKEND=mock  # mock|triton
TRITON_URL=http://localhost:8001

# Observability Configuration
JAEGER_ENDPOINT=http://localhost:14268/api/traces
PROMETHEUS_URL=http://localhost:9090

# Application Configuration
API_GATEWAY_PORT=8000
CASE_SERVICE_PORT=8001
IMAGE_SERVICE_PORT=8002
INFERENCE_SERVICE_PORT=8003
EHR_SERVICE_PORT=8004
GRAPH_SERVICE_PORT=8005
ONTOLOGY_ADMIN_SERVICE_PORT=8006
AUDIT_SERVICE_PORT=8007

# Security Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Clinical Configuration
PATTERN_CONFIDENCE_THRESHOLD=0.55
MUTATION_CONFIDENCE_THRESHOLD=0.60
ENABLE_HITL=true
MAX_IMAGE_SIZE_MB=100

# Development Configuration
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development
