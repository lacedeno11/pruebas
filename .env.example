# Environment Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/policy_validation
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# Vector Database Configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_COLLECTION_NAME=policy_documents

# ML Services Configuration
ML_MODEL_REGISTRY_URL=http://localhost:8002
ML_FEATURE_STORE_URL=http://localhost:8003
ML_CLASSIFICATION_MODEL_VERSION=v1.0.0
ML_ANOMALY_MODEL_VERSION=v1.0.0
ML_ETA_MODEL_VERSION=v1.0.0

# Object Storage Configuration
OBJECT_STORAGE_TYPE=local
OBJECT_STORAGE_BUCKET=policy-documents
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=

# Authentication and Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# RBAC/ABAC Configuration
RBAC_ENABLED=true
ABAC_ENABLED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Guardrails Configuration
GUARDRAILS_ENABLED=true
PII_DETECTION_ENABLED=true
ALLOWLIST_SOURCES_ONLY=true
INJECTION_DETECTION_ENABLED=true
EVIDENCE_ANCHORING_REQUIRED=true

# External Integrations
CRM_API_URL=http://localhost:9000/api
CRM_API_KEY=
CRM_WEBHOOK_SECRET=

INSURER_API_TIMEOUT=30
INSURER_API_RETRIES=3
INSURER_API_BACKOFF_FACTOR=2

# Monitoring and Observability
SENTRY_DSN=
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8080
JAEGER_ENABLED=false
JAEGER_ENDPOINT=

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC

# LangGraph Configuration
LANGGRAPH_CHECKPOINTER_TYPE=postgres
LANGGRAPH_MAX_ITERATIONS=50
LANGGRAPH_RECURSION_LIMIT=100

# Thresholds Configuration
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MEDIUM_THRESHOLD=0.65
RISK_LOW_THRESHOLD=0.3
RISK_HIGH_THRESHOLD=0.7
COVERAGE_OK_THRESHOLD=0.8
ANOMALY_HIGH_THRESHOLD=0.8

# SLA Configuration
DEFAULT_SLA_HOURS=24
PRIORITY_HIGH_SLA_HOURS=4
PRIORITY_CRITICAL_SLA_HOURS=1

# Audit Configuration
AUDIT_RETENTION_DAYS=2555  # 7 years
AUDIT_EXPORT_ENABLED=true
AUDIT_ENCRYPTION_ENABLED=true
