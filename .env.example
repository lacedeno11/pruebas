# =============================================================================
# Policy Validation Copilot - Environment Configuration
# =============================================================================

# Application Settings
APP_NAME=Policy Validation Copilot
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# Database Configuration
DATABASE_URL=postgresql://policy_user:policy_pass@localhost:5432/policy_copilot
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20

# Security Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# LangGraph Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=policy-copilot

# ML Services Configuration
ML_SERVICES_BASE_URL=http://localhost:8002
ML_CLASSIFICATION_ENDPOINT=/api/v1/classify
ML_ANOMALY_ENDPOINT=/api/v1/anomaly
ML_ETA_ENDPOINT=/api/v1/eta
ML_MODEL_REGISTRY_URL=http://localhost:5000
ML_FEATURE_STORE_URL=http://localhost:6566

# Vector Database Configuration (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=policy_documents
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Object Storage Configuration
OBJECT_STORAGE_TYPE=local  # local, s3, azure, gcs
OBJECT_STORAGE_BUCKET=policy-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=your-access-key
OBJECT_STORAGE_SECRET_KEY=your-secret-key
OBJECT_STORAGE_ENDPOINT=http://localhost:9000  # For MinIO
LOCAL_STORAGE_PATH=./data/documents

# Knowledge Base Configuration
KB_INDEX_NAME=policy_kb
KB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=200
KB_SIMILARITY_THRESHOLD=0.7

# Guardrails Configuration
GUARDRAILS_SERVICE_URL=http://localhost:8003
RBAC_CONFIG_PATH=./config/rbac.yaml
ABAC_CONFIG_PATH=./config/abac.yaml
PII_DETECTION_MODEL=en_core_web_sm
ALLOWLIST_SOURCES_PATH=./config/allowlist_sources.yaml
INJECTION_DETECTION_ENABLED=true
EVIDENCE_ANCHORING_ENABLED=true

# External Integrations
CRM_WEBHOOK_URL=http://localhost:8000/api/v1/webhooks/crm
CRM_API_BASE_URL=https://api.crm-system.com
CRM_API_KEY=your-crm-api-key
CRM_TIMEOUT_SECONDS=30

INSURER_API_TIMEOUT_SECONDS=60
INSURER_RETRY_ATTEMPTS=3
INSURER_RETRY_BACKOFF=2

# Notification Configuration
NOTIFICATION_SERVICE_URL=http://localhost:8004
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-email@company.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM_ADDRESS=noreply@policycopilot.com

# Queue Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC

# Monitoring and Observability
PROMETHEUS_METRICS_PORT=8001
PROMETHEUS_METRICS_PATH=/metrics
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_SERVICE_NAME=policy-copilot
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Audit and Compliance
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_LEVEL=INFO
AUDIT_EXPORT_ENCRYPTION=true
AUDIT_EXPORT_KEY_PATH=./config/audit_key.pem

# Business Rules Configuration
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MEDIUM_THRESHOLD=0.65
RISK_HIGH_THRESHOLD=0.75
RISK_MEDIUM_THRESHOLD=0.45
ANOMALY_HIGH_THRESHOLD=0.8
COVERAGE_MINIMUM_THRESHOLD=0.7

# SLA Configuration
DEFAULT_SLA_HOURS=24
PRIORITY_HIGH_SLA_HOURS=4
PRIORITY_MEDIUM_SLA_HOURS=12
PRIORITY_LOW_SLA_HOURS=48

# HITL Configuration
HITL_QUEUE_NAME=hitl_review
HITL_TIMEOUT_HOURS=72
HITL_ESCALATION_HOURS=24
HITL_NOTIFICATION_ENABLED=true

# Development and Testing
TESTING_DATABASE_URL=postgresql://policy_user:policy_pass@localhost:5432/policy_copilot_test
MOCK_ML_SERVICES=false
MOCK_EXTERNAL_APIS=false
ENABLE_DEBUG_ENDPOINTS=true

# Feature Flags
ENABLE_ML_CLASSIFICATION=true
ENABLE_ML_ANOMALY_DETECTION=true
ENABLE_ML_ETA_PREDICTION=true
ENABLE_EXTERNAL_INSURER_QUERIES=true
ENABLE_POLICY_AS_CODE=true
ENABLE_CONTINUOUS_LEARNING=true
