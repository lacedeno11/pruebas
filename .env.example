# =============================================================================
# Policy Validation Copilot - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the actual values
# DO NOT commit .env file to version control

# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME=Policy Validation Copilot
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/policy_validation
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Database Migration
ALEMBIC_CONFIG=alembic.ini

# =============================================================================
# Security Configuration
# =============================================================================
# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# =============================================================================
# LangGraph Configuration
# =============================================================================
# Confidence Thresholds
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MEDIUM_THRESHOLD=0.65
CONFIDENCE_LOW_THRESHOLD=0.45

# Risk Thresholds
RISK_HIGH_THRESHOLD=0.75
RISK_MEDIUM_THRESHOLD=0.50
RISK_LOW_THRESHOLD=0.25

# Coverage Thresholds
COVERAGE_OK_THRESHOLD=0.80
COVERAGE_PARTIAL_THRESHOLD=0.60

# Anomaly Thresholds
ANOMALY_HIGH_THRESHOLD=0.80
ANOMALY_MEDIUM_THRESHOLD=0.60

# =============================================================================
# ML Services Configuration
# =============================================================================
# ML Classification Service
ML_CLASSIFY_ENDPOINT=http://localhost:8001/classify
ML_CLASSIFY_TIMEOUT=30
ML_CLASSIFY_RETRIES=3
ML_CLASSIFY_MODEL_VERSION=v1.0.0

# ML Anomaly Detection Service
ML_ANOMALY_ENDPOINT=http://localhost:8002/anomaly
ML_ANOMALY_TIMEOUT=30
ML_ANOMALY_RETRIES=3
ML_ANOMALY_MODEL_VERSION=v1.0.0

# ML ETA Prediction Service
ML_ETA_ENDPOINT=http://localhost:8003/eta
ML_ETA_TIMEOUT=30
ML_ETA_RETRIES=3
ML_ETA_MODEL_VERSION=v1.0.0

# Feature Store Configuration
FEATURE_STORE_ENDPOINT=http://localhost:8004
FEATURE_STORE_TIMEOUT=30

# =============================================================================
# Vector Database Configuration (ChromaDB)
# =============================================================================
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=policy_documents
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# =============================================================================
# External Services Configuration
# =============================================================================
# OpenAI Configuration (if using OpenAI embeddings/LLM)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Object Storage Configuration (S3-compatible)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=policy-documents
OBJECT_STORAGE_REGION=us-east-1

# =============================================================================
# CRM/Ticketing Integration
# =============================================================================
CRM_ENDPOINT=https://api.crm-system.com
CRM_API_KEY=your-crm-api-key
CRM_TIMEOUT=30
CRM_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# Insurer Connector Configuration
# =============================================================================
# External Insurer APIs
INSURER_API_ENDPOINTS={"insurer1": "https://api.insurer1.com", "insurer2": "https://api.insurer2.com"}
INSURER_API_KEYS={"insurer1": "key1", "insurer2": "key2"}
INSURER_TIMEOUT=60
INSURER_RETRIES=2

# Email Configuration for Insurer Communication
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@company.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# =============================================================================
# Guardrails Configuration
# =============================================================================
# RBAC/ABAC Configuration
RBAC_ENABLED=true
RBAC_POLICY_FILE=config/rbac_policy.json

# PII Masking Configuration
PII_MASKING_ENABLED=true
PII_MASKING_FIELDS=["customer_id", "contract_id", "provider_id"]

# Source Allowlist Configuration
SOURCE_ALLOWLIST_ENABLED=true
SOURCE_ALLOWLIST_FILE=config/source_allowlist.json

# Anti-Hallucination Configuration
EVIDENCE_ANCHORING_ENABLED=true
EVIDENCE_ANCHORING_MIN_SCORE=0.70

# Security Detection Configuration
INJECTION_DETECTION_ENABLED=true
JAILBREAK_DETECTION_ENABLED=true
EXFILTRATION_DETECTION_ENABLED=true

# =============================================================================
# Monitoring and Observability
# =============================================================================
# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Logging Configuration
LOG_FORMAT=json
LOG_FILE=logs/policy_validation.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# =============================================================================
# SLA and Queue Configuration
# =============================================================================
# Default SLA Targets (in minutes)
SLA_HIGH_PRIORITY=60
SLA_MEDIUM_PRIORITY=240
SLA_LOW_PRIORITY=1440

# Queue Configuration
QUEUE_HIGH_PRIORITY=high_priority_queue
QUEUE_MEDIUM_PRIORITY=medium_priority_queue
QUEUE_LOW_PRIORITY=low_priority_queue
QUEUE_HITL=hitl_review_queue

# =============================================================================
# Cache Configuration
# =============================================================================
# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=5
REDIS_MAX_CONNECTIONS=10

# Cache TTL (in seconds)
CACHE_TTL_POLICIES=3600
CACHE_TTL_EXCEPTIONS=1800
CACHE_TTL_ML_SCORES=900

# =============================================================================
# Development and Testing
# =============================================================================
# Testing Configuration
TEST_DATABASE_URL=postgresql+asyncpg://test:test@localhost:5432/policy_validation_test
TEST_SKIP_SLOW=false
TEST_COVERAGE_THRESHOLD=80

# Development Tools
DEV_RELOAD=true
DEV_DEBUG=true
DEV_PROFILING=false
