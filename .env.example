# DERCAS-ONCO-XAI V1 Environment Configuration
# Copy this file to .env and configure the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DSN=postgresql://oncology_user:oncology_pass@localhost:5432/oncology_db
POSTGRES_DB=oncology_db
POSTGRES_USER=oncology_user
POSTGRES_PASSWORD=oncology_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# MESSAGE BROKER CONFIGURATION
# =============================================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Redis for Celery backend
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# OBJECT STORAGE (MinIO S3-Compatible)
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=oncology-data
S3_REGION=us-east-1
S3_USE_SSL=false

# Bucket names for different data types
S3_BUCKET_IMAGES=oncology-images
S3_BUCKET_OVERLAYS=oncology-overlays
S3_BUCKET_XAI=oncology-xai
S3_BUCKET_EHR=oncology-ehr
S3_BUCKET_REPORTS=oncology-reports
S3_BUCKET_ONTOLOGY=oncology-ontology

# =============================================================================
# AUTHENTICATION & AUTHORIZATION (Keycloak OIDC)
# =============================================================================
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=oncology-realm
KEYCLOAK_CLIENT_ID=oncology-client
KEYCLOAK_CLIENT_SECRET=your-client-secret-here
JWKS_URL=http://localhost:8081/realms/oncology-realm/protocol/openid-connect/certs

# Admin credentials for Keycloak setup
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# =============================================================================
# TRIPLE STORE (Apache Jena Fuseki)
# =============================================================================
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET=oncology
FUSEKI_ADMIN_USER=admin
FUSEKI_ADMIN_PASSWORD=fuseki_admin

# =============================================================================
# AI & MACHINE LEARNING
# =============================================================================
# LLM Provider: mock (default), openai, anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model Backend: mock (default), triton
MODEL_BACKEND=mock
TRITON_URL=http://localhost:8000

# Model configuration
MODEL_PATTERN_VERSION=lung_patterns_v3
MODEL_MUTATION_VERSION=genetic_mutations_v2
MODEL_CONFIDENCE_THRESHOLD=0.55

# =============================================================================
# OBSERVABILITY & MONITORING
# =============================================================================
# Jaeger distributed tracing
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Prometheus metrics
PROMETHEUS_ENDPOINT=http://localhost:9090
PROMETHEUS_PUSHGATEWAY=http://localhost:9091

# OpenTelemetry
OTEL_SERVICE_NAME=oncology-xai
OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces
OTEL_RESOURCE_ATTRIBUTES=service.name=oncology-xai,service.version=1.0.0

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Gateway
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8080
API_GATEWAY_WORKERS=4

# Service ports (internal)
CASE_SERVICE_PORT=8001
IMAGE_SERVICE_PORT=8002
INFERENCE_SERVICE_PORT=8003
EHR_SERVICE_PORT=8004
GRAPH_SERVICE_PORT=8005
ONTOLOGY_ADMIN_SERVICE_PORT=8006
AUDIT_SERVICE_PORT=8007

# WebApp
WEBAPP_PORT=3000
WEBAPP_API_URL=http://localhost:8080

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Configuration
JWT_ALGORITHM=RS256
JWT_AUDIENCE=oncology-client
JWT_ISSUER=http://localhost:8081/realms/oncology-realm

# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Request size limits (in MB)
MAX_REQUEST_SIZE=100
MAX_IMAGE_SIZE=50

# =============================================================================
# CLINICAL CONFIGURATION
# =============================================================================
# Confidence thresholds for clinical guardrails
PATTERN_CONFIDENCE_THRESHOLD=0.55
MUTATION_CONFIDENCE_THRESHOLD=0.60
MAPPING_CONFIDENCE_THRESHOLD=0.70

# HITL (Human-in-the-Loop) policies
HITL_ENABLED=true
HITL_LOW_CONFIDENCE_THRESHOLD=0.50
HITL_CONFLICT_DETECTION=true

# Clinical guardrails
GUARDRAILS_ENABLED=true
GUARDRAILS_STRICT_MODE=true
GUARDRAILS_REQUIRE_LIMITATIONS=true

# =============================================================================
# ONTOLOGY CONFIGURATION
# =============================================================================
# Ontology sources (whitelisted for security)
ONTOLOGY_SOURCES_WHITELIST=https://purl.obolibrary.org/obo/,https://www.ebi.ac.uk/ols/
ONTOLOGY_AUTO_UPDATE=false
ONTOLOGY_REASONER_ENABLED=true

# Default ontology versions
NCIT_VERSION=23.03d
MONDO_VERSION=2023-04-04
SO_VERSION=2023-02-21

# =============================================================================
# CELERY CONFIGURATION
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# Worker configuration
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# =============================================================================
# AUDIT & COMPLIANCE
# =============================================================================
# Audit configuration
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=2555  # 7 years for clinical compliance
AUDIT_PHI_REDACTION=true
AUDIT_SIEM_EXPORT=false

# Event deduplication
EVENT_DEDUPLICATION_ENABLED=true
EVENT_DEDUPLICATION_WINDOW_SECONDS=300

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
# Test database (separate from main DB)
TEST_POSTGRES_DSN=postgresql://test_user:test_pass@localhost:5433/test_oncology_db

# Mock services for development
MOCK_SERVICES_ENABLED=true
MOCK_ML_MODELS=true
MOCK_LLM_RESPONSES=true

# Development tools
ENABLE_SWAGGER_UI=true
ENABLE_REDOC=true
ENABLE_DEBUG_TOOLBAR=false

# =============================================================================
# DOCKER COMPOSE OVERRIDES
# =============================================================================
# These can be overridden in docker-compose.override.yml
COMPOSE_PROJECT_NAME=oncology-xai
COMPOSE_FILE=infra/docker-compose.yml

# Volume mounts for development
DEV_MOUNT_SOURCE=true
DEV_MOUNT_LOGS=true

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================
# Backup configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=oncology-backups

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Feature toggles for gradual rollout
FEATURE_ADVANCED_XAI=true
FEATURE_REAL_TIME_UPDATES=true
FEATURE_BATCH_PROCESSING=false
FEATURE_EXTERNAL_EHR_INTEGRATION=false
FEATURE_ADVANCED_ONTOLOGY_REASONING=false

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Database connection pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# HTTP client timeouts
HTTP_TIMEOUT=30
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=30

# Cache configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
