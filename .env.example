# DERCAS-ONCO-XAI Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DSN=postgresql://dercas_user:dercas_password@localhost:5432/dercas_onco_xai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dercas_onco_xai
POSTGRES_USER=dercas_user
POSTGRES_PASSWORD=dercas_password

# =============================================================================
# MESSAGE BROKER CONFIGURATION
# =============================================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Redis for Celery backend
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# OBJECT STORAGE CONFIGURATION (MinIO)
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dercas-onco-xai
S3_REGION=us-east-1
S3_USE_SSL=false

# =============================================================================
# AUTHENTICATION & AUTHORIZATION (Keycloak)
# =============================================================================
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=dercas
KEYCLOAK_CLIENT_ID=dercas-onco-xai
KEYCLOAK_CLIENT_SECRET=your-client-secret-here
JWKS_URL=http://localhost:8080/auth/realms/dercas/protocol/openid-connect/certs

# Admin credentials for Keycloak setup
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# =============================================================================
# TRIPLE STORE CONFIGURATION (Apache Jena Fuseki)
# =============================================================================
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET=dercas
FUSEKI_USERNAME=admin
FUSEKI_PASSWORD=fuseki_password

# =============================================================================
# LLM PROVIDERS CONFIGURATION
# =============================================================================
# LLM Provider: mock|openai|anthropic
LLM_PROVIDER=mock

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.1

# Anthropic Configuration (if using Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_TEMPERATURE=0.1

# =============================================================================
# ML MODEL BACKEND CONFIGURATION
# =============================================================================
# Model Backend: mock|triton
MODEL_BACKEND=mock

# Triton Inference Server (if using Triton)
TRITON_URL=http://localhost:8001
TRITON_MODEL_REPOSITORY=/models

# Model Configuration
PATTERN_MODEL_NAME=lung_patterns_v3
MUTATION_MODEL_NAME=genetic_mutations_v2
XAI_MODEL_NAME=explainability_v1

# Inference Thresholds
PATTERN_THRESHOLD_LEPIDIC=0.55
PATTERN_THRESHOLD_ACINAR=0.55
PATTERN_THRESHOLD_PAPILLARY=0.55
PATTERN_THRESHOLD_MICROPAPILLARY=0.55
PATTERN_THRESHOLD_SOLID=0.55
MUTATION_THRESHOLD_EGFR=0.6
MUTATION_THRESHOLD_KRAS=0.6
MUTATION_THRESHOLD_TP53=0.6

# =============================================================================
# OBSERVABILITY CONFIGURATION
# =============================================================================
# Jaeger Tracing
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Prometheus Metrics
PROMETHEUS_GATEWAY=http://localhost:9091
PROMETHEUS_JOB_NAME=dercas-onco-xai

# OpenTelemetry
OTEL_SERVICE_NAME=dercas-onco-xai
OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces
OTEL_RESOURCE_ATTRIBUTES=service.name=dercas-onco-xai,service.version=0.1.0

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Environment: development|staging|production
ENVIRONMENT=development

# API Gateway
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
API_GATEWAY_WORKERS=4

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# File Upload Limits
MAX_IMAGE_SIZE_MB=100
MAX_EHR_SIZE_MB=10
ALLOWED_IMAGE_FORMATS=png,biff
ALLOWED_EHR_FORMATS=txt,pdf,json

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Configuration
JWT_ALGORITHM=RS256
JWT_AUDIENCE=dercas-onco-xai
JWT_ISSUER=http://localhost:8080/auth/realms/dercas

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# Session Configuration
SESSION_SECRET_KEY=your-super-secret-session-key-change-this-in-production
SESSION_TIMEOUT_MINUTES=480

# =============================================================================
# CLINICAL CONFIGURATION
# =============================================================================
# Clinical Guardrails
ENABLE_CLINICAL_GUARDRAILS=true
REQUIRE_DISCLAIMERS=true
PREVENT_DEFINITIVE_DIAGNOSIS=true

# HITL (Human-in-the-Loop) Policies
ENABLE_HITL_REVIEW=true
HITL_LOW_CONFIDENCE_THRESHOLD=0.7
HITL_CONFLICT_DETECTION=true

# Audit Configuration
ENABLE_AUDIT_LOGGING=true
AUDIT_RETENTION_DAYS=2555  # 7 years for clinical compliance
PHI_REDACTION_ENABLED=true

# =============================================================================
# ONTOLOGY CONFIGURATION
# =============================================================================
# Ontology Sources (whitelisted for security)
ONTOLOGY_SOURCES_WHITELIST=https://purl.obolibrary.org/obo/ncit.owl,https://purl.obolibrary.org/obo/mondo.owl,https://purl.obolibrary.org/obo/so.owl

# Ontology Update Configuration
ONTOLOGY_AUTO_UPDATE=false
ONTOLOGY_UPDATE_CHECK_INTERVAL_HOURS=24
ONTOLOGY_REASONER_TIMEOUT_SECONDS=300

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Debug Settings
DEBUG=true
LOG_LEVEL=INFO
ENABLE_SWAGGER_UI=true
ENABLE_REDOC=true

# Development Database (SQLite for quick testing)
DEV_DATABASE_URL=sqlite:///./dercas_dev.db

# Mock Data Configuration
ENABLE_MOCK_DATA=true
MOCK_PATIENT_COUNT=10
MOCK_CASE_COUNT=25

# =============================================================================
# WEBAPP CONFIGURATION
# =============================================================================
# React App Configuration
REACT_APP_API_BASE_URL=http://localhost:8000
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_KEYCLOAK_REALM=dercas
REACT_APP_KEYCLOAK_CLIENT_ID=dercas-onco-xai

# Development Mode
REACT_APP_DEV_MODE=true
REACT_APP_MOCK_AUTH=false

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Docker Compose Override
COMPOSE_PROJECT_NAME=dercas-onco-xai
COMPOSE_FILE=infra/docker-compose.yml

# Container Resource Limits
POSTGRES_MAX_CONNECTIONS=100
RABBITMQ_VM_MEMORY_HIGH_WATERMARK=0.8
REDIS_MAXMEMORY=256mb
MINIO_BROWSER=on

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================
# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=dercas-backups

# =============================================================================
# MONITORING AND ALERTING
# =============================================================================
# Health Check Configuration
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=10

# Alerting (if configured)
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=smtp.example.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=alerts@dercas.example.com
ALERT_EMAIL_TO=admin@dercas.example.com
