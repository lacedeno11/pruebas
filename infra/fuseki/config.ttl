@prefix :        <#> .
@prefix fuseki:  <http://jena.apache.org/fuseki#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ja:      <http://jena.hpl.hp.com/2005/11/Assembler#> .
@prefix tdb2:    <http://jena.apache.org/2016/tdb#> .

## DERCAS-ONCO-XAI V1 Fuseki Configuration
## Configures datasets for ontology storage and case-specific graphs

[] rdf:type fuseki:Server ;
   fuseki:services (
     :oncology
     :ontologies
   ) .

## Main oncology dataset for case-specific graphs
:oncology rdf:type fuseki:Service ;
    fuseki:name "oncology" ;
    fuseki:serviceQuery "sparql" ;
    fuseki:serviceQuery "query" ;
    fuseki:serviceUpdate "update" ;
    fuseki:serviceUpload "upload" ;
    fuseki:serviceReadWriteGraphStore "data" ;
    fuseki:serviceReadGraphStore "get" ;
    fuseki:dataset :oncology_dataset .

:oncology_dataset rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/oncology" ;
    tdb2:unionDefaultGraph true .

## Ontologies dataset for NCIt, MONDO, SO storage
:ontologies rdf:type fuseki:Service ;
    fuseki:name "ontologies" ;
    fuseki:serviceQuery "sparql" ;
    fuseki:serviceQuery "query" ;
    fuseki:serviceUpdate "update" ;
    fuseki:serviceUpload "upload" ;
    fuseki:serviceReadWriteGraphStore "data" ;
    fuseki:serviceReadGraphStore "get" ;
    fuseki:dataset :ontologies_dataset .

:ontologies_dataset rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/ontologies" ;
    tdb2:unionDefaultGraph false .
