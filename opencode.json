{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "minimax": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MiniMax",
      "options": {
        "baseURL": "https://api.minimaxi.chat/v1",
        "apiKey": "{env:MINIMAX_API_KEY}"
      },
      "models": {
        "MiniMax-M2.5": {
          "name": "MiniMax M2.5",
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        }
      }
    }
  },
  "model": "minimax/MiniMax-M2.5",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "fetch": "allow",
    "mcp": "allow"
  }
}
