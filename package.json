{
  "name": "dercas-pei",
  "version": "0.1.0",
  "description": "DERCAS PEI: Agentic Platform for Telco Work Order Management",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspaces",
    "install": "npm install"
  },
  "devDependencies": {
    "typescript": "5.3.3",
    "@types/node": "20.x",
    "concurrently": "8.x"
  }
}

