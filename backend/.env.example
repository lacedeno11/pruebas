# System Mode
SYSTEM_MODE=MOCK

# Database
DATABASE_URL=sqlite:///./pei.db

# OpenAI API Key
OPENAI_API_KEY=your-api-key-here

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your-token

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email
SMTP_PASSWORD=your-password

# Crew Configuration
MAX_CREW_CAPACITY=10
PROXIMITY_RADIUS_KM=10

# Governance Settings
INACTIVITY_ALERT_DAYS=20,25,29
AUTO_CANCEL_DAYS=30

