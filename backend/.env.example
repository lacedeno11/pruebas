# =============================================================================
# PEI Platform - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values for development/production

# Database Configuration
# For development, SQLite is convenient. For production, use PostgreSQL:
# PostgreSQL: postgresql://user:password@localhost:5432/pei_db
# SQLite: sqlite:///./pei.db
DATABASE_URL=sqlite:///./pei.db

# System Mode: MOCK or PRODUCTION
# MOCK: Uses MockApiService to simulate TELCOS and TelcoDrive APIs (development)
# PRODUCTION: Uses real API clients (requires proper API configuration)
SYSTEM_MODE=MOCK

# OpenAI Configuration
# Required for LLM-based routing in RouterAgent
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# Geographic Constraints (in kilometers)
# Maximum distance from cuadrilla centroid to assign an OT
MAX_DISTANCE_KM=10

# Cuadrilla Configuration
# Daily capacity per cuadrilla (number of OTs)
CUADRILLA_DAILY_CAPACITY=5

# Governance Configuration
# Hours before PREPLANIFICADA OTs trigger inactivity alert
INACTIVITY_THRESHOLD_HOURS=48

# Days in DETENIDA status before auto-cancellation to ANULADA
CANCELLATION_THRESHOLD_DAYS=30

# Days to send cancellation reminders (comma-separated, no spaces)
ALERT_DAYS=20,25,29

# Telegram Configuration
# Bot token for sending notifications to technical teams
# Get from BotFather on Telegram: https://t.me/BotFather
# Leave empty to disable Telegram notifications (graceful degradation)
TELEGRAM_BOT_TOKEN=xxx

# Email Configuration
# SMTP server settings for sending notifications to clients/PMs
# Leave empty to disable email notifications (graceful degradation)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

