# System Mode
SYSTEM_MODE=MOCK

# Database
DATABASE_URL=sqlite:///./pei.db

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4

# External APIs
TELCOS_API_BASE_URL=https://api.telconet.ec
TELCOS_API_KEY=your-telcos-key
TELCODRIVE_API_URL=https://drive.telconet.ec/api

# Notifications
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_COORDINADOR_CHAT_ID=123456789
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@telconet.ec
SMTP_PASSWORD=your-password
EMAIL_FROM=PEI System <noreply@telconet.ec>

# Business Rules
MAX_DISTANCE_KM=10.0
AUTO_CANCEL_DAYS=30
ALERT_DAYS=20,25,29
INACTIVITY_ALERT_HOURS=48
MOCK_LATENCY_MS=500

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

