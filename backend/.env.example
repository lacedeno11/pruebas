# System Configuration
SYSTEM_MODE=MOCK

# Database Configuration
DATABASE_URL=sqlite:///./pei.db

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# External API Configuration
TELCOS_API_BASE_URL=https://api.telcos.example.com
TELCODRIVE_API_BASE_URL=https://telcodrive.example.com

# Email Configuration
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=noreply@telconet.com

# Governance Configuration
ALERT_DETENTION_DAYS=20,25,29
AUTO_CANCEL_DAYS=30
PREPLANNED_ALERT_HOURS=48
PROXIMITY_RADIUS_KM=10

