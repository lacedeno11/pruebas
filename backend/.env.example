# PEI Platform Environment Configuration
# Copy this file to .env and fill in with your actual values

# Database Configuration
# For SQLite: sqlite:///./pei_platform.db
# For PostgreSQL: postgresql://user:password@localhost:5432/pei_platform
DATABASE_URL=sqlite:///./pei_platform.db

# System Mode: MOCK for development (uses mock API service), PRODUCTION for live
SYSTEM_MODE=MOCK

# OpenAI API Key for LLM-based agents (GPT-5.2 or compatible)
OPENAI_API_KEY=your_openai_api_key_here

# Telegram Bot Token for crew notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# SMTP Configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Mock API Latency (milliseconds) - simulates API response time for testing loading states
MOCK_API_LATENCY_MS=500

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

