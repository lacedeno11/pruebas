# =============================================================================
# Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values

# API Configuration
# Base URL for the FastAPI backend API
# Development: http://localhost:8000
# Production: https://api.yourbackend.com
VITE_API_BASE_URL=http://localhost:8000

# Optional: Mapbox Token for enhanced map features
# Get your token from https://account.mapbox.com/
# Leave empty to use OpenStreetMap (free, no token required)
VITE_MAPBOX_TOKEN=your_token_here

